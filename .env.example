# Choose ONE provider: gemini | openai | anthropic
LLM_PROVIDER=gemini

# Add the key for the provider you chose
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the default model for the provider
# gemini default: gemini-2.5-flash | openai default: gpt-4o-mini | anthropic default: claude-haiku-5-5
LLM_MODEL=
